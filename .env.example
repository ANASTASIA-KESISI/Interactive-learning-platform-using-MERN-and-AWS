# Copy this file to .env in each workspace that needs it (/server, /client).
# Never commit real secrets — .env is gitignored.
#
# Precedence is: real process environment > server/.env > this repo-root .env.
# On a deployed host set configuration through the platform's environment
# (EC2 user data, Amplify env vars, systemd unit) rather than shipping a .env —
# NODE_ENV and CODE_RUNNER_ADAPTER in particular.

# ---------- Server ----------
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/learncode

# AWS region for all AWS SDK clients
AWS_REGION=eu-west-1

# AWS Cognito — get these from the User Pool after creation
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_xxxxxxxxx

# DynamoDB table names
DYNAMO_PROGRESS_TABLE=learncode_progress

# S3 bucket for media/static assets
S3_MEDIA_BUCKET=learncode-media

# Code runner adapter — `dev` (Node vm, in-process) or `lambda` (AWS Lambda).
#
# `dev` is OPT-IN ONLY: anything else (unset, empty, misspelled) resolves to
# `lambda`, and asking for `dev` while NODE_ENV=production refuses to boot. The
# dev adapter executes untrusted student code inside the API process and is not
# a sandbox, so a missing variable must never select it. See CHALLENGES.md
# Challenge 6.
CODE_RUNNER_ADAPTER=dev
# Per-language Lambda function names (only read when CODE_RUNNER_ADAPTER=lambda).
# Python is registered only if its variable is set — leave it unset on hosts
# where the function is not deployed, and Python submissions are refused at
# dispatch with a clear message instead of an AWS ResourceNotFoundException.
# In dev mode, non-JavaScript languages are routed to Lambda regardless, since
# the in-process runner can only execute JavaScript.
LAMBDA_RUNNER_JS_FUNCTION=learncode-runner-js
LAMBDA_RUNNER_PY_FUNCTION=learncode-runner-py

# CORS origin for the frontend dev server
CLIENT_ORIGIN=http://localhost:5173

# Invite code that lets a self-registered account claim the `instructor` role
# (POST /api/auth/claim-instructor). Leave empty to disable self-service
# instructor signup entirely. Use a long random value in production.
INSTRUCTOR_INVITE_CODE=

# ---------- Client ----------
# (Prefix with VITE_ so Vite exposes them to the browser bundle)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=eu-west-1
