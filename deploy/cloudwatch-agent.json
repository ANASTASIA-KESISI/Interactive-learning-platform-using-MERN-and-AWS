{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/learncode/api.log",
            "log_group_name": "/learncode/api",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC",
            "retention_in_days": 90
          }
        ]
      }
    }
  }
}
