# Tails the API's journal into a plain file for the CloudWatch agent.
#
# The API logs one JSON line per event to stdout, which systemd stores in the
# journal. The CloudWatch agent cannot read the journal, only files. Rather than
# point the API's stdout at a file — which would need an API restart and would
# blind `journalctl -u learncode-api`, which the deploy script relies on — this
# unit copies the journal into /var/log/learncode/api.log as it grows.
#
# `--cursor-file` remembers where it got to, so a restart of this unit (or a
# reboot) resumes from the last shipped line instead of dropping or repeating.
# `-o cat` strips the journal prefix so each line stays valid JSON for the
# agent and for Logs Insights.
#
# Installed by deploy/setup-cloudwatch.sh; refreshed by deploy/update-ec2.sh.

[Unit]
Description=LearnCode API journal -> /var/log/learncode/api.log
After=systemd-journald.service learncode-api.service
Wants=learncode-api.service

[Service]
Type=simple
ExecStart=/usr/bin/journalctl -u learncode-api -f -o cat --no-pager \
  --cursor-file=/var/lib/learncode-journal/cursor
StandardOutput=append:/var/log/learncode/api.log
StandardError=journal
Restart=always
RestartSec=5

# systemd creates these with the right ownership and lets us write to them
# even under ProtectSystem=strict.
LogsDirectory=learncode
StateDirectory=learncode-journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
